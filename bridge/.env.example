FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace-me
DSH_COMMAND=dsh
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-flash
# 工作区（会话与执行体映射的落盘位置）；缺省为 ../feishu-assistant-workspace
DSH_WORKSPACE=/absolute/path/to/feishu-assistant-workspace

# 允许使用机器人的用户 open_id，逗号分隔。**生产必配**：执行体能跑命令。
FEISHU_ALLOWED_USERS=ou_xxxxxxxxxxxxxxxx
