{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@feishu-assistant/dsh-executor/contract": [
        "../packages/executor/src/contract.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
